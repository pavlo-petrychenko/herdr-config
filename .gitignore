# Allowlist: Herdr's home also holds shipped files and runtime state.
/*
!/.gitignore
!/README.md
!/RECIPE.md
!/LICENSE
!/preview.png
!/install.sh
!/extras/
!/keys.json
!/settings.json
!/repo-worktree.json
!/space-groups.json
!/spaces-flat-patch.py
!/spaces-flat-sync.sh
!/package.json
!/kit/

!/layouts/
/layouts/*
!/layouts/main-flat.json

!/mods/
/mods/*
!/mods/agent-queue/
!/mods/agent-usage/
!/mods/file-viewer/
!/mods/prs/
!/mods/repo-worktree/
!/mods/space-groups/
!/mods/spaces-flat/
!/mods/viewbar/

# Per-machine setting of the PRs mod: { "cli": "/abs/path/to/herdr-prs" }.
/mods/prs/config.json

# Written by Herdr into each mod.
**/gpui-kit.d.ts
**/herdr.d.ts
.DS_Store
